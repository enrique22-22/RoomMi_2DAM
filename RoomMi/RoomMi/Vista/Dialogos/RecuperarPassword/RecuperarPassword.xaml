<mah:MetroWindow x:Class="RoomMi.ProyectoIntermodular.EnriqueyAdrian.Vista.Dialogos.RecuperarPassword.RecuperarPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:RoomMi.ProyectoIntermodular.EnriqueyAdrian.Vista.Dialogos.RecuperarPassword"
        mc:Ignorable="d"
        Title="LOGIN RoomMi" Height="700" Width="800"
        MinHeight="600" MinWidth="700"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= COLUMNA IZQUIERDA ================= -->
        <Grid Grid.Column="0">

            <Image Source="/Recursos/Imagenes/Imagen-fondo-RoomMi.jpg" Stretch="Fill" />

            <Viewbox Stretch="Uniform" MaxWidth="600" Margin="20">
                <StackPanel Width="360" VerticalAlignment="Center">

                    <Image Source="/Recursos/Iconos/Logo-RoomMi.png" Height="64" />

                    <TextBlock Text="R o o m M i"
                               HorizontalAlignment="Center"
                               Foreground="Red"
                               FontSize="60" />

                    <TextBlock Text="Con esta aplicación puedes validar publicaciones de habitaciones, gestionar los usuarios caseros e inquilinos, controlar las reservas y supervisar la plataforma."
                               Width="350"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="WrapWithOverflow" />

                </StackPanel>
            </Viewbox>

        </Grid>

        <!-- ================= COLUMNA DERECHA ================= -->
        <Grid Grid.Column="1">

            <!-- Degradado lineal de Oscuro a Coral (sin tamaño fijo) -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#333" Offset="0.1" />
                        <GradientStop Color="#FF385C" Offset="0.4" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Viewbox Stretch="Uniform" MaxWidth="600" Margin="20">
                <StackPanel Width="360">

                    <TextBlock Text="¿Olvidaste tu contraseña?"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               FontSize="30" />

                    <TextBlock Text="R o o m M i"
                               HorizontalAlignment="Center"
                               FontSize="50"
                               FontWeight="Bold"
                               Foreground="Red" />

                    <Image Source="/Recursos/Iconos/Logo-RoomMi.png"
                           Margin="0,10,0,0"
                           Height="60" />

                    <TextBlock Text="Introduce el correo electrónico asociado a tu cuenta y te enviaremos un enlace para restablecer tu contraseña."
                               Width="300"
                               Margin="0,10,0,0"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="WrapWithOverflow" />

                    <TextBox HorizontalAlignment="Center" Width="300"
                             Margin="0,20,0,0"
                             x:Name="txtCorreoElectronico"
                             BorderBrush="Gray"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             mat:TextFieldAssist.HasClearButton="True"
                             mat:TextFieldAssist.TextFieldCornerRadius="25">
                        <mat:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2 0 0 0">
                                <mat:PackIcon Kind="Mail" />
                                <TextBlock Margin="2,0,0,0" Text="Correo Electrónico" />
                            </StackPanel>
                        </mat:HintAssist.Hint>
                    </TextBox>

                    <Button Width="300" Margin="0,30,0,0"
                            Content="Restablecer Contraseña"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btnAceptar_Click"
                            mat:ButtonAssist.CornerRadius="25"
                            VerticalAlignment="Center"
                            Background="#EA4335" />

                    <StackPanel Orientation="Vertical" Width="300" Margin="0,15,0,0">
                        <TextBlock Text="¿No has recibido ningún correo electrónico?"
                                   HorizontalAlignment="Center" />

                        <Button Content="Reenviar"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                FontSize="12"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="0"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Separador "OR" con Grid en lugar de anchos fijos -->
                    <Grid Width="250" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Separator Grid.Column="0" Background="Gray" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="OR"
                                   Foreground="Gray"
                                   Margin="10,0,10,0"
                                   VerticalAlignment="Center" />
                        <Separator Grid.Column="2" Background="Gray" VerticalAlignment="Center" />
                    </Grid>

                    <Button Width="250" Margin="0,15,0,0"
                            Content="Iniciar sesión"
                            Foreground="White"
                            BorderThickness="0"
                            mat:ButtonAssist.CornerRadius="25"
                            VerticalAlignment="Center"
                            Background="#EA4335"
                            x:Name="CambioInicioSesion"
                            Click="CambioInicioSesion_Click" />

                </StackPanel>
            </Viewbox>

        </Grid>

    </Grid>
</mah:MetroWindow>