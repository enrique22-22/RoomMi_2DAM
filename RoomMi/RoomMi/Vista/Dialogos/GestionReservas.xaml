<Window x:Class="RoomMi.Vista.Dialogos.GestionReservas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoomMi.Vista.Dialogos"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Background="#202124"
        Icon="/Recursos/Iconos/Logo-RoomMi.png"
        WindowStyle="None" AllowsTransparency="True"
        WindowState="Maximized"
        Loaded="MetroWindow_Loaded"
        Title="GestionReservas" Height="900" Width="1300">

    <Window.Resources>
        <Style TargetType="Button" x:Key="MenuButton">
        </Style>
    </Window.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Left" Width="250" Background="#28313B">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="10,10,0,0">
                    <Image Source="/Recursos/Iconos/Logo-RoomMi.png" Height="50"/>
                    <TextBlock Text="RoomMi" FontSize="30"
                               Foreground="White" FontWeight="Bold"
                               Margin="5,15,0,16"/>
                </StackPanel>

                <Separator/>

            </StackPanel>

            <StackPanel Grid.Row="1">

                <!-- Boton Dashboard -->
                <Button Margin="10,10,10,10" Background="Transparent" Height="50" HorizontalContentAlignment="Left" BorderBrush="Transparent" Click="btnDashboard_Click"  >
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Recursos/Iconos/iconoDashboard2.png" Height="25" Stretch="Uniform" />
                        <TextBlock Margin="10,0,0,0" Text="Dashboard" Foreground="White" VerticalAlignment="Center" FontSize="18" />
                    </StackPanel>
                </Button>

                <!-- Boton Validar -->
                <Button Background="Transparent" Margin="10,0,10,10" Height="50" BorderBrush="Transparent" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Recursos/Iconos/iconoValidarOfertas2.png" Stretch="Uniform" Height="25" />
                        <TextBlock Margin="10,0,0,0" Text="Validar Ofertas" Foreground="White" VerticalAlignment="Center" FontSize="18" />
                    </StackPanel>
                </Button>

                <!-- Boton Reservas -->
                <Button Background="Transparent" Height="50" Margin="10,0,10,10" BorderBrush="Transparent" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Recursos/Iconos/iconoGestionReservas2.png" Height="25" Stretch="Uniform" />
                        <TextBlock Margin="10,0,0,0" Text="Gestión de Reservas" Foreground="White" VerticalAlignment="Center" FontSize="18" />
                    </StackPanel>
                </Button>

                <!-- Boton Usuarios -->
                <Button Background="Transparent" Height="50" Margin="10,0,10,10" BorderBrush="Transparent" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Recursos/Iconos/iconoGestionUsuarios2.png" Height="25" Stretch="Uniform" />
                        <TextBlock Margin="10,0,0,0" Text="Gestión de Usuarios" Foreground="White" VerticalAlignment="Center" FontSize="18" />
                    </StackPanel>
                </Button>

                <!-- Boton Permisos -->
                <Button  Background="Transparent" Height="50" Margin="10,0,10,10" BorderBrush="Transparent" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Recursos/Iconos/iconoPermisosRoles2.png" Height="25" Stretch="Uniform" />
                        <TextBlock Margin="10,0,0,0" Text="Permisos y Roles" Foreground="White" VerticalAlignment="Center" FontSize="18" />
                    </StackPanel>
                </Button>

                <Separator />

            </StackPanel>

            <!-- Boton Administrador -->
            <Button Background="Transparent" Height="50" Grid.Row="2" BorderBrush="Transparent" VerticalAlignment="Bottom" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Recursos/Iconos/iconoLogin2.png" Height="25" Stretch="Uniform" />
                    <TextBlock Margin="10,0,0,0" Foreground="White" VerticalAlignment="Center" FontSize="18" x:Name="tbNombreUsuario" />
                    <Button Background="Transparent" Height="30" BorderBrush="Transparent" VerticalAlignment="Bottom" Click="bntLogOut"  >
                        <Image Source="/Recursos/Iconos/iconoLogOut2.png" Margin="10,0,0,0" Height="25" Stretch="Uniform"  />
                    </Button>
                </StackPanel>
            </Button>


        </Grid>

        <Grid DockPanel.Dock="Top" Height="100" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!-- Texto Dashboard y Resumen General -->
            <TextBlock Text="Gestión de Reservas"
                       Grid.Column="0"
                       FontSize="35" 
                       FontWeight="Bold"
                       Margin="20,20,0,0" 
                       Foreground="White" />

            <!-- Boton de la derecha de Notificaciones -->
            <Button Grid.Column="3" 
                    Background="Transparent"
                    HorizontalAlignment="Right"
                    BorderBrush="Transparent"
                    Height="50"
                    Width="55"
                    x:Name="btnNotificaciones"
                    Click="btnNotificaciones_Click"
                    Margin="0,20,10,0">

                <Grid>

                    <!-- Campana -->
                    <Image Source="/Recursos/Iconos/iconoCampana (1).png"
                           Width="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <!-- Número de notificaciones -->
                    <Border Background="#C52233"
                            Width="18"
                            Height="18"
                            CornerRadius="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,0,4,0">

                        <TextBlock Text="7"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                </Grid>


                <Button.ContextMenu>
                    <ContextMenu Width="340"
                                 Background="#1A1A24"
                                 Foreground="White"
                                 Padding="0">

                        <MenuItem IsEnabled="False">
                            <MenuItem.Header>
                                <TextBlock Text="NOTIFICACIONES"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="5"/>
                            </MenuItem.Header>
                        </MenuItem>

                        <Separator/>

                        <MenuItem IsEnabled="False">
                            <MenuItem.Header>
                                <TextBlock Text="●  Nueva solicitud de reserva"
                                               Foreground="#38BDF8"
                                               FontWeight="Bold"
                                               FontSize="13"/>
                            </MenuItem.Header>
                        </MenuItem>

                        <Separator/>

                        <MenuItem IsEnabled="False">
                            <MenuItem.Header>
                                <TextBlock Text="✓  Reserva confirmada"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="13"/>
                            </MenuItem.Header>
                        </MenuItem>

                        <Separator/>

                        <MenuItem IsEnabled="False">
                            <MenuItem.Header>
                                <TextBlock Text="●  Nuevo mensaje"
                                               Foreground="#38BDF8"
                                               FontWeight="Bold"
                                               FontSize="13"/>
                            </MenuItem.Header>
                        </MenuItem>

                        <Separator/>

                        <MenuItem IsEnabled="False">
                            <MenuItem.Header>
                                <TextBlock Text="!   Reserva pendiente"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="13"/>
                            </MenuItem.Header>
                        </MenuItem>

                        <Separator/>

                        <MenuItem IsEnabled="False">
                            <MenuItem.Header>
                                <TextBlock Text="✓  Habitación publicada"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontSize="13"/>
                            </MenuItem.Header>
                        </MenuItem>

                        <Separator/>

                        <MenuItem IsEnabled="False">
                            <MenuItem.Header>
                                <TextBlock Text="Ver todas las notificaciones"
                                           Foreground="#38BDF8"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="5"/>
                            </MenuItem.Header>
                        </MenuItem>

                    </ContextMenu>
                </Button.ContextMenu>

            </Button>

            <!-- Boton minimizar -->
            <Button Grid.Column="5" 
                    Style="{StaticResource MenuButton}"
                    x:Name="btnMinimize" Click="btnMinimize_Click"
                    Background="Transparent"
                    HorizontalAlignment="Right"
                    BorderBrush="Transparent"
                    Height="25"
                    Width="25"
                    Margin="0,20,10,0">

                <Image Source="/Recursos/Iconos/minimizar.png" Width="14" Height="20" />

            </Button>

            <!-- Boton maximizar -->
            <Button Grid.Column="6" 
                    Style="{StaticResource MenuButton}"
                    x:Name="btnMaximize" Click="btnMaximize_Click"
                    Background="Transparent"
                    HorizontalAlignment="Right"
                    BorderBrush="Transparent"
                    Height="25"
                    Width="25"
                    Margin="0,20,10,0">

                <Image Source="/Recursos/Iconos/maximizar.png" Width="14"/>

            </Button>

            <!-- Boton cerrar -->
            <Button Grid.Column="7" 
                    Style="{StaticResource MenuButton}"
                    Background="Transparent"
                    x:Name="btnClose" Click="btnClose_Click"
                    HorizontalAlignment="Right"
                    BorderBrush="Transparent"
                    Height="25"
                    Width="25"
                    Margin="0,20,10,0">

                <Image Source="/Recursos/Iconos/cerrar.png" Width="14" Height="15" />

            </Button>

        </Grid>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Creación de las 4 tarjeras -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="5,0,5,15">

                <Border BorderBrush="#52323A" BorderThickness="1" CornerRadius="12" Margin="10" Padding="18,14" Height="105">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#382026" Offset="0.0"/>
                            <GradientStop Color="#181D26" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="56" Height="56" Margin="0,0,16,0">
                            <Ellipse Stroke="#4A3238" StrokeThickness="5"/>
                            <Path Stroke="#E86A5A" 
                                  StrokeThickness="5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 28,4 A 24,24 0 1 1 4.4,23.5"/>

                            <TextBlock Text="78%"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtPorcentajeOcupacion" Text="78%" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="Ocupación" Foreground="#94A3B8" FontSize="13" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderBrush="#2B4257" BorderThickness="1" CornerRadius="12" Margin="10" Padding="18,14" Height="105">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A2B3C" Offset="0.0"/>
                            <GradientStop Color="#181D26" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="50" Height="50" CornerRadius="25" Background="#22384D" Margin="0,0,16,0">
                            <mat:PackIcon Kind="CalendarCheckOutline"
                                          Width="24" Height="24"
                                          Foreground="#38BDF8"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <!-- Textos -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtCheckInsHoy"
                                       Text="6"
                                       Foreground="White"
                                       FontSize="26"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Check-ins Hoy" Foreground="#94A3B8" FontSize="13" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tarjeta 3: Pendientes (Degradado ámbar oscuro de advertencia) -->
                <Border BorderBrush="#523E28" BorderThickness="1" CornerRadius="12" Margin="10" Padding="18,14" Height="105">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#36281A" Offset="0.0"/>
                            <GradientStop Color="#181D26" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="50" Height="50" CornerRadius="25" Background="#473724" Margin="0,0,16,0">
                            <mat:PackIcon Kind="Alert" 
                                          Width="24"
                                          Height="24"
                                          Foreground="#F5A623"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtPendientes" Text="8" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="Pendientes" Foreground="#94A3B8" FontSize="13" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderBrush="#26473B" BorderThickness="1" CornerRadius="12" Margin="10" Padding="18,14" Height="105">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#162E26" Offset="0.0"/>
                            <GradientStop Color="#181D26" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtIngresos" 
                                       Text="€12.450"
                                       Foreground="White" 
                                       FontSize="26" 
                                       FontWeight="Bold"/>
                            
                            <TextBlock Text="Ingresos" Foreground="#94A3B8" FontSize="13" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Mini gráfico de barras + flecha verde a la derecha -->
                        <Grid Grid.Column="1" Width="46" Height="42" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                <Border Width="5" Height="12" Background="#3B5249" CornerRadius="2" Margin="2,0" VerticalAlignment="Bottom"/>
                                <Border Width="5" Height="18" Background="#3B5249" CornerRadius="2" Margin="2,0" VerticalAlignment="Bottom"/>
                                <Border Width="5" Height="24" Background="#3B5249" CornerRadius="2" Margin="2,0" VerticalAlignment="Bottom"/>
                                <Border Width="5" Height="30" Background="#3B5249" CornerRadius="2" Margin="2,0" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <mat:PackIcon Kind="TrendingUp" Width="40"
                                          Height="40"
                                          Foreground="#4ADE80"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            
                        </Grid>
                    </Grid>
                </Border>

            </UniformGrid>

            <!-- Parte de la simulación al acceso a la BD -->
            <Grid Grid.Row="1" Margin="15,0,15,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6.8*"/>
                    <ColumnDefinition Width="3.2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#28313B"
                        BorderBrush="#3B455D"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="0,0,15,0"
                        Padding="20">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. TÍTULO -->
                        <TextBlock Grid.Row="0"
                                   Text="LISTADO DE RESERVAS"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,0,0,14"/>

                        <!-- 2. BARRA DE BÚSQUEDA, FILTROS Y EXPORTAR -->
                        <Grid Grid.Row="1" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Buscador -->
                            <Border Grid.Column="0"
                                    Background="#1E252E"
                                    BorderBrush="#3B455D"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Height="36"
                                    Padding="10,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <mat:PackIcon Kind="Magnify" Foreground="#858FA8" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="txtBuscarReserva"
                                             Grid.Column="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="White"
                                             CaretBrush="White"
                                             FontSize="12"
                                             VerticalContentAlignment="Center"
                                             mat:HintAssist.Hint="Buscar por cliente, id..."
                                             mat:HintAssist.Foreground="#858FA8"/>
                                </Grid>
                            </Border>

                            <!-- Píldoras de filtro -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                <Button x:Name="btnFiltroTodas" Content="Todas"
                                        Background="#3B455D" Foreground="White" BorderThickness="0"
                                        Height="30" Padding="14,0" Margin="0,0,6,0" FontSize="12"
                                        mat:ButtonAssist.CornerRadius="15" Cursor="Hand"/>

                                <Button x:Name="btnFiltroPendientes" Content="Pendientes"
                                        Background="#1E252E" Foreground="#CBD5E1" BorderBrush="#3B455D" BorderThickness="1"
                                        Height="30" Padding="14,0" Margin="0,0,6,0" FontSize="12"
                                        mat:ButtonAssist.CornerRadius="15" Cursor="Hand"/>

                                <Button x:Name="btnFiltroConfirmadas" Content="Confirmadas"
                                        Background="#1E252E" Foreground="#CBD5E1" BorderBrush="#3B455D" BorderThickness="1"
                                        Height="30" Padding="14,0" Margin="0,0,6,0" FontSize="12"
                                        mat:ButtonAssist.CornerRadius="15" Cursor="Hand"/>

                                <Button x:Name="btnFiltroIncidencias" Content="Incidencias"
                                        Background="#1E252E" Foreground="#CBD5E1" BorderBrush="#3B455D" BorderThickness="1"
                                        Height="30" Padding="14,0" FontSize="12"
                                        mat:ButtonAssist.CornerRadius="15" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Botón Exportar Informe -->
                            <Button x:Name="btnExportarInforme"
                                    Grid.Column="2"
                                    Background="#333E4B"
                                    BorderBrush="#475569"
                                    BorderThickness="1"
                                    Foreground="White"
                                    Height="36"
                                    Padding="14,0"
                                    mat:ButtonAssist.CornerRadius="8"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Exportar Informe" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <mat:PackIcon Kind="Download" Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 3. CABECERAS DE LA TABLA -->
                        <Grid Grid.Row="2" Margin="12,0,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="ID / CLIENTE" Foreground="#858FA8" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="HABITACIÓN"   Foreground="#858FA8" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="ENTRADA"      Foreground="#858FA8" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="SALIDA"       Foreground="#858FA8" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Grid.Column="4" Text="ESTADO"       Foreground="#858FA8" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Grid.Column="5" Text="IMPORTE"      Foreground="#858FA8" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Grid.Column="6" Text="ACCIONES"     Foreground="#858FA8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="3" Height="1" Background="#3B455D" Margin="0,0,0,6"/>

                        <!-- 4. FILAS DE RESERVAS -->
                        <StackPanel Grid.Row="4" VerticalAlignment="Top">

                            <!-- FILA 1 -->
                            <Grid Height="54" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="2040014" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Annen Clariqs" Foreground="#CBD5E1" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="Hab. Ruzafa" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="03/09/2026" Foreground="#E2E8F0" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="12/09/2026" Foreground="#E2E8F0" FontSize="12" VerticalAlignment="Center"/>
                                <Border Grid.Column="4" Background="#F05454" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="CONFIRMADA" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Grid.Column="5" Text="€156,00" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Padding="4" Height="28" Foreground="#94A3B8">
                                        <mat:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Padding="4" Height="28" Foreground="#94A3B8">
                                        <mat:PackIcon Kind="EyeOutline" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Padding="4" Height="28" Foreground="#94A3B8">
                                        <mat:PackIcon Kind="TrashCanOutline" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- FILA 2 (RESALTADA / SELECCIONADA) -->
                            <Border Background="#2F3846" BorderBrush="#D96B60" BorderThickness="1.5" CornerRadius="8" Margin="0,2">
                                <Grid Height="54" Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1.0*"/>
                                        <ColumnDefinition Width="1.0*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="2040050" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Janes Fantels" Foreground="#CBD5E1" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Piso Centro" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="03/09/2026" Foreground="#E2E8F0" FontSize="12" VerticalAlignment="Center"/>
