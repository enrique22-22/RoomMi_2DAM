                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <TextBlock Text="Habitaciones" Foreground="#94A3B8" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="148" Foreground="White" FontSize="40" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tarjeta 2: Reservas Activas -->
                <Border CornerRadius="12" Margin="15" Padding="20" Height="180">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
