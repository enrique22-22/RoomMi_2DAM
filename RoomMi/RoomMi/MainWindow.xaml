                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <TextBlock Text="Reservas Activas" Foreground="#94A3B8" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="56" Foreground="White" FontSize="40" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tarjeta 3: Validaciones Pendientes -->
