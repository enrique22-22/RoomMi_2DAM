                            <TextBlock Text="8 Por Revisar" Foreground="White" FontSize="30" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tarjeta 4: Ingresos Totales -->
